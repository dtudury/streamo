{
  "extends": "./jsconfig.json",
  "include": [
    "index.js",
    "bin/**/*.js",
    "public/streamo/**/*.js",
    "scripts/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.js",
    "public/streamo/utils/testing.js",
    "public/streamo/utils/mockDOM.js"
  ],
  "compilerOptions": {
    "maxNodeModuleJsDepth": 0
  }
}
