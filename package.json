{
  "name": "@dtudury/streamo",
  "version": "16.0.1",
  "description": "peer-to-peer sync where your data and identity belong to you, not the server",
  "keywords": [
    "p2p",
    "peer-to-peer",
    "sync",
    "reactive",
    "content-addressed",
    "websocket",
    "signed",
    "append-only",
    "offline-first",
    "cryptographic",
    "identity"
  ],
  "homepage": "https://streamo.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dtudury/streamo.git"
  },
  "bugs": {
    "url": "https://github.com/dtudury/streamo/issues"
  },
  "author": "David Tudury <david.tudury@gmail.com>",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./*": "./public/streamo/*"
  },
  "files": [
    "index.js",
    "bin/",
    "public/",
    "!**/*.test.js",
    "!public/streamo/utils/testing.js"
  ],
  "bin": "./bin/streamo2.js",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@aws-sdk/client-s3": "^3.958.0",
    "@gerhobbelt/gitignore-parser": "^0.2.0-9",
    "@parcel/watcher": "^2.5.1",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "mkcert": "^3.2.0",
    "readline-sync": "^1.4.10",
    "ws": "^8.18.3"
  },
  "scripts": {
    "test": "npm run typecheck:gate && node --test",
    "backup-contexts": "bash $HOME/Documents/repos/the-grove/scripts/backup-contexts.sh",
    "typecheck": "tsc -p jsconfig.json",
    "typecheck:gate": "tsc -p jsconfig.gate.json",
    "repl": "node scripts/repl2.mjs"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  },
  "standard": {
    "ignore": [
      "public/streamo/utils/noble-secp256k1.js"
    ]
  }
}
